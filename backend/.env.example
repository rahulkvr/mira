# Geofox GTI (HVV) API credentials
# Get credentials from HVV/Geofox developer portal
GEOFOX_USER=your_geofox_username
GEOFOX_PASSWORD=your_geofox_password

# Optional: override API base (default https://gti.geofox.de)
# GEOFOX_BASE_URL=https://gti.geofox.de

# Server port (Railway provides this automatically in production)
PORT=3001

# Node environment
NODE_ENV=development

# Supabase (get from Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Gemini (script + topic generation)
GEMINI_API_KEY=your_gemini_api_key
# Optional: override model
# GEMINI_MODEL=gemini-1.5-flash

# ElevenLabs (text-to-speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Optional: override voice
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Optional: eleven_flash_v2_5 (fastest) or eleven_multilingual_v2
# ELEVENLABS_MODEL=eleven_flash_v2_5
