# Geofox GTI (HVV) API credentials — required for transit routes
# Get credentials from HVV/Geofox developer portal
GEOFOX_USER=your_geofox_username
GEOFOX_PASSWORD=your_geofox_password

# Optional: override API base (default http://gti.geofox.de)
# GEOFOX_BASE_URL=http://gti.geofox.de

# Server port
PORT=3001

# Node environment
NODE_ENV=development

# --- Gemini (podcast script, interests, MicroMaster text + images) ---
GEMINI_API_KEY=your_gemini_api_key
# Optional: text model (default gemini-1.5-flash in some routes, gemini-2.5-flash in MicroMaster)
# GEMINI_MODEL=gemini-2.5-flash
# Optional: interests route only
# GEMINI_INTERESTS_MODEL=gemini-1.5-flash
# Optional: MicroMaster slide images (default gemini-2.5-flash-image)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- ElevenLabs (podcast + MicroMaster TTS) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Optional: voice ID — different voices sound more or less expressive. If audio feels monotonous, try a more dynamic voice from ElevenLabs Voice Library (e.g. Alex, Josh, or other "expressive" voices). Default: 21m00Tcm4TlvDq8ikWAM (Rachel).
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Optional: model (default eleven_flash_v2_5)
# ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Supabase (only if backend uses it; Render blueprint references these) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_KEY=your_supabase_service_key
