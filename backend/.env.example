# Geofox GTI (HVV) API credentials
# Get credentials from HVV/Geofox developer portal
GEOFOX_USER=your_geofox_username
GEOFOX_PASSWORD=your_geofox_password

# Optional: override API base (default https://gti.geofox.de)
# GEOFOX_BASE_URL=https://gti.geofox.de

# Server port (Railway provides this automatically in production)
PORT=3001

# Node environment
NODE_ENV=development

# Supabase (get from Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
